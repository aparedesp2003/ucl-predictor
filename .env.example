# Supabase Postgres, session pooler (port 5432)
DATABASE_URL=
# https://www.football-data.org API token
FOOTBALL_DATA_TOKEN=
# apps/web: read-only role from docs/sql/web_readonly.sql (falls back to DATABASE_URL in dev only)
WEB_DATABASE_URL=
# apps/web: shared secret for POST /api/revalidate (also a GitHub Actions secret, with SITE_URL)
REVALIDATE_SECRET=
# apps/web: public origin used for metadata, sitemap.xml and robots.txt, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
