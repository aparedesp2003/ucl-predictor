{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "engine: sync deps",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/apps/engine" },
      "problemMatcher": []
    },
    {
      "label": "engine: test",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}/apps/engine" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "engine: lint",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check .",
      "options": { "cwd": "${workspaceFolder}/apps/engine" },
      "problemMatcher": []
    },
    {
      "label": "engine: migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}/apps/engine" },
      "problemMatcher": []
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "web: typecheck + lint",
      "type": "shell",
      "command": "pnpm exec tsc --noEmit && pnpm lint",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "check: all",
      "dependsOn": ["engine: lint", "engine: test", "web: typecheck + lint"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
