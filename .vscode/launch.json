{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Engine: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["engine.api.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/engine",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Engine: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/apps/engine",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Engine: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/apps/engine",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Web: Next.js server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "Web: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Engine: FastAPI", "Web: Next.js server"],
      "stopAll": true
    }
  ]
}
